[Unit]
Description=investMITRA independent morning data check
Wants=network-online.target
After=network-online.target
OnFailure=investmitra-data-failure.service

[Service]
Type=oneshot
User=investmitra-data
Group=investmitra-data
WorkingDirectory=/opt/investmitra-data/app
EnvironmentFile=/etc/investmitra-data/pipeline.env
Environment=PYTHONUNBUFFERED=1 TZ=Asia/Kolkata
Environment="PIPELINE_LOG_HINT=Server logs: journalctl -u investmitra-readiness.service"
ExecStart=/opt/investmitra-data/venv/bin/python scripts/run_server_pipeline.py --check-only
TimeoutStartSec=10min
StateDirectory=investmitra-data
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
