# =============================================================================
# ClearedCircle — Environment Variables
# Copy to .env — never commit .env to git
# =============================================================================

CC_ENV=local        # local | prod
CC_DB_SCHEMA=public # local: public | prod: investmitra

# =============================================================================
# LOCAL DEV — Docker services
# =============================================================================
# Object store (MinIO)
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
CC_BUCKET_RAW=cc-raw
CC_BUCKET_QUARANTINE=cc-quarantine

# Metadata DB (Docker postgres on 5432)
CC_POSTGRES_URL=postgresql://cc:cc@localhost:5432/clearedcircle

# Time-series DB (Docker timescaledb on 5433)
CC_TIMESCALE_URL=postgresql://cc:cc@localhost:5433/clearedcircle

# Redis
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# PRODUCTION — Replace values below, comment out local section above
# =============================================================================

# Cloudflare R2 (free: 10GB, 10M reads, 1M writes, zero egress)
# Get from: Cloudflare Dashboard → R2 → Manage API Tokens
# AWS_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# AWS_REGION=auto
# CC_BUCKET_RAW=cc-raw
# CC_BUCKET_QUARANTINE=cc-quarantine

# Neon (free: 0.5GB, never pauses, Postgres 16, Singapore region)


# CC_POSTGRES_URL=postgresql://investmitra_owner:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&options=-csearch_path%3Dinvestmitra
# CC_TIMESCALE_URL=postgresql://investmitra_owner:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&options=-csearch_path%3Dinvestmitra

# Prefect Cloud (free tier — no server needed)
# Get from: app.prefect.io → Settings → API Keys
# PREFECT_API_KEY=pnu_...
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<ACCOUNT_ID>/workspaces/<WORKSPACE_ID>

# Redis Cloud (free: 30MB — enough for Phase 1 feature cache)
# REDIS_URL=redis://:<password>@<host>:<port>

# =============================================================================
# EXTERNAL DATA APIs
# =============================================================================
FRED_API_KEY=
RBI_DBIE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ClearedCircle/1.0 by YourUsername
YOUTUBE_DATA_API_KEY=

# Alerting
SLACK_WEBHOOK_URL=
